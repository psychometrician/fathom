#!/bin/sh
# .prepare — stage the engine's sources into the package, before it is tarred up
#
# The package farm builds a monorepo package like this:
#
#     git clone <repo>              # the whole repository, crates included
#     PKGDIR=<repo>/r-pkg/fathom    # the `subdir` field in packages.json
#     (cd $PKGDIR; sh .prepare) || true      # ← this script, in the FULL clone
#     R CMD build $PKGDIR           # → fathom_x.y.z.tar.gz, from the subdir ALONE
#                                   #   every platform binary is built from that
#
# **The trap is the last line.** `fathom-core/` and `fathom-cli/` sit *above*
# `$PKGDIR`, so they never enter the tarball, and `inst/bin/` is gitignored so it
# arrives empty. A tarball built that way carries no engine and no way to make
# one, and `configure` then refuses on every platform — correctly, but pointing
# at the wrong step.
#
# This script is the one moment the crates are still reachable. It copies them to
# `tools/rust/`, which `R CMD build` includes and `R CMD INSTALL` does not try to
# compile, so `configure` has a source that travels.
#
# **It verifies its own work, and that is not defensive habit.** The farm runs it
# as `|| true`, so a failure here is *swallowed* and resurfaces much later as a
# configure error on every platform at once. A staging step that fails silently
# is the same silent drop this project refuses everywhere else.
#
# **THERE IS SOMETHING TO VENDOR HERE, AND THE SIBLING HAD NOTHING.** god's
# equivalent records that `god-core` declares no runtime dependencies at all, so
# a vendoring step would copy nothing and prove nothing. fathom is not in that
# position: it reads bytes off a disk and `04-gharchive` was unreadable for want
# of gzip, so `flate2` is load-bearing. Vendored it is **six pure-Rust crates and
# about 1.2 MB** — measured, not estimated — which buys a build that reaches the
# network for nothing. That matters twice: a farm builder with a cold or absent
# proxy still compiles, and CRAN's offline rule stays satisfiable later rather
# than being foreclosed now by a decision nobody revisited.
#
# Usage:  sh .prepare

set -e

WORKSPACE="../.."
DEST="tools/rust"

# ---------------------------------------------------------------------------
# Refuse early rather than half-stage. If the crates are not above us, this is
# not the layout the script was written for, and copying nothing while exiting 0
# is the exact failure it exists to prevent.
# ---------------------------------------------------------------------------
if [ ! -f "${WORKSPACE}/Cargo.toml" ] || [ ! -d "${WORKSPACE}/fathom-core" ]; then
  echo "fathom/.prepare: no crate sources at ${WORKSPACE}/ — nothing to stage." >&2
  echo "  Expected ${WORKSPACE}/Cargo.toml and ${WORKSPACE}/fathom-core/." >&2
  echo "  This script runs from the package directory inside a full checkout." >&2
  exit 1
fi

echo "* fathom/.prepare: staging the engine sources into ${DEST}/"

# **Clear any engine a previous install left behind.** `inst/bin/` is gitignored,
# so on the farm it arrives empty — that build starts from a fresh clone. On a
# developer's machine it does not: `R CMD INSTALL` puts a binary there and
# nothing takes it away, so `R CMD build` would package whatever the last install
# produced. That tarball then carries an engine older than its own version
# number, and `configure` PREFERS a prebuilt `inst/bin/` over every other source,
# so the stale one is installed and never rebuilt. An assumption stated in a
# comment is not enforcement; deleting is.
rm -rf inst/bin

rm -rf "${DEST}"
mkdir -p "${DEST}"

cp "${WORKSPACE}/Cargo.toml"     "${DEST}/Cargo.toml"
cp "${WORKSPACE}/Cargo.lock"     "${DEST}/Cargo.lock"
cp -R "${WORKSPACE}/fathom-core" "${DEST}/fathom-core"
cp -R "${WORKSPACE}/fathom-cli"  "${DEST}/fathom-cli"

# A development checkout may have a warm `target/` inside a crate directory. It
# is hundreds of megabytes and rebuilt anyway, so it must not travel.
rm -rf "${DEST}/fathom-core/target" "${DEST}/fathom-cli/target"

# ---------------------------------------------------------------------------
# Vendor, so the build reaches the network for nothing
# ---------------------------------------------------------------------------
#
# `cargo vendor` is run from inside the staged tree rather than the workspace,
# because cargo resolves its configuration by walking up from the WORKING
# DIRECTORY. Run from the workspace it would write paths relative to there, and
# the tarball has no workspace above it.
#
# The config it prints is what redirects crates.io to the vendored copies, and it
# has to land in `.cargo/config.toml` INSIDE the staged tree for the same reason.
if command -v cargo >/dev/null 2>&1; then
  CARGO=cargo
elif [ -x "${HOME}/.cargo/bin/cargo" ]; then
  CARGO="${HOME}/.cargo/bin/cargo"
else
  CARGO=""
fi

if [ -n "${CARGO}" ]; then
  mkdir -p "${DEST}/.cargo"
  ( cd "${DEST}" && "${CARGO}" vendor vendor ) > "${DEST}/.cargo/config.toml" 2>/dev/null || {
    echo "fathom/.prepare: cargo vendor failed — the staged build will need the network" >&2
    rm -f "${DEST}/.cargo/config.toml"
  }
else
  echo "fathom/.prepare: no cargo here, so nothing is vendored." >&2
  echo "  The staged sources still travel; the build will fetch its one" >&2
  echo "  dependency from the network instead." >&2
fi

# ---------------------------------------------------------------------------
# Verify. Everything above can appear to work and leave a tarball that cannot
# build, so the postconditions are checked rather than assumed.
# ---------------------------------------------------------------------------
for f in "${DEST}/Cargo.toml" "${DEST}/Cargo.lock" \
         "${DEST}/fathom-core/Cargo.toml" "${DEST}/fathom-core/src/lib.rs" \
         "${DEST}/fathom-cli/Cargo.toml"  "${DEST}/fathom-cli/src/main.rs"; do
  if [ ! -f "$f" ]; then
    echo "fathom/.prepare: staging incomplete — $f is missing." >&2
    exit 1
  fi
done

if [ -f "${DEST}/.cargo/config.toml" ] && [ ! -d "${DEST}/vendor" ]; then
  echo "fathom/.prepare: a vendor config was written and there is no vendor/." >&2
  echo "  That combination builds NOTHING: cargo would redirect crates.io to a" >&2
  echo "  directory that does not exist." >&2
  exit 1
fi

echo "* fathom/.prepare: staged $(du -sh "${DEST}" | cut -f1) into ${DEST}/"
